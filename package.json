{
	"name": "nextjs",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"test": "node --test \"test/**/*.test.js\" && npx tsx --test \"test/**/*.test.ts\"",
		"test:worker": "node --test cloudflare/worker/test/router.test.js",
		"test:watchdog": "node --test cloudflare/watchdog/test/watchdog.test.js",
		"test:edge": "npm run test:worker && npm run test:watchdog",
		"worker:dry-run": "npx --yes wrangler@4.123.0 deploy --dry-run --config cloudflare/worker/wrangler.toml",
		"watchdog:dry-run": "npx --yes wrangler@4.123.0 deploy --dry-run --config cloudflare/watchdog/wrangler.toml",
		"test:e2e": "playwright test",
		"test:e2e:hydration": "E2E_LIVE_HYDRATION=1 playwright test e2e/live-hydration.spec.ts",
		"test:e2e:ui": "playwright test --ui",
		"contract:graphql": "npx tsx scripts/validate-queries-vs-schema.ts",
		"measure:fixtures": "node scripts/measure-fixtures-performance.mjs",
		"measure:gameweek": "node scripts/measure-gameweek-performance.mjs",
		"measure:market": "node scripts/measure-market-performance.mjs",
		"measure:player-stats": "node scripts/measure-player-stats-performance.mjs",
		"measure:trends": "node scripts/measure-trends-performance.mjs",
		"measure:home": "node scripts/measure-home-performance.mjs",
		"measure:competitions": "node scripts/measure-competitions-performance.mjs",
		"load:agent-gateway": "node scripts/load-agent-gateway.mjs",
		"platform-admin:resolve-user": "node scripts/resolve-platform-admin-user.mjs",
		"lint": "eslint .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate.ts",
		"db:migrate:status": "tsx scripts/migrate-status.ts",
		"db:verify-runtime-login": "tsx scripts/verify-runtime-login.ts",
		"db:bootstrap-runtime-login": "tsx scripts/bootstrap-runtime-login.ts",
		"db:runtime-contract": "tsx scripts/check-runtime-database-contract.ts",
		"db:studio": "drizzle-kit studio"
	},
