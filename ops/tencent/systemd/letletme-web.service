[Unit]
Description=LetLetMe Next.js candidate origin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=letletme
Group=letletme
WorkingDirectory=/opt/letletme/current
EnvironmentFile=/etc/letletme/web.env
EnvironmentFile=/etc/letletme/release.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
Environment=NODE_OPTIONS=--max-old-space-size=768
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=30s
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/opt/letletme
ReadWritePaths=/var/cache/letletme-next
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=1250M
TasksMax=128
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
