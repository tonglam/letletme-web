# --- Existing -----------------------------------------------------------
GRAPHQL_ENDPOINT=http://127.0.0.1:4000/graphql

# Briefing rollout switch. Keep false until the publication canary is verified.
BRIEFING_PUBLIC_ENABLED=false
# HMAC secret for POST /api/internal/briefing/revalidate.
BRIEFING_REVALIDATE_SECRET=

# Maintenance switch. With this exact value, all pages
# render the localized maintenance state and Data/GraphQL-dependent Web APIs
# return 503. Better Auth and Mini Program identity APIs remain available.
# Server-only: never prefix either variable with NEXT_PUBLIC_.
MAINTENANCE_MODE=false
# Integer seconds from 30 through 3600. Invalid values use 300 seconds.
MAINTENANCE_RETRY_AFTER_SECONDS=300

# Data API used for tournament mutations and entry synchronization. After a
# user binds an FPL entry, Web asks this service to queue its synchronization.
LETLETME_DATA_URL=http://127.0.0.1:4001
# Plaintext key sent as x-api-key on the entry-sync call; its SHA-256 digest
# belongs in Data's DATA_API_KEY_HASHES. REQUIRED in production (Data enforces
# auth under NODE_ENV=production). Never prefix with NEXT_PUBLIC_.
LETLETME_DATA_API_KEY=
# Server-only Briefing command credentials. Never expose these as NEXT_PUBLIC vars.
LETLETME_CONTENT_EDITOR_API_KEY=
LETLETME_CONTENT_PUBLISHER_API_KEY=
# Keep the operator surface disabled until the content canary is complete.
BRIEFING_ADMIN_ENABLED=false
BRIEFING_EDITOR_EMAILS=
BRIEFING_PUBLISHER_EMAILS=

# Fraction of production page loads that report privacy-bounded Core Web
# Vitals to /api/vitals. Use a value from 0 to 1 (defaults to 0.25).
NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=0.25

# --- Better Auth + Drizzle (new) ---------------------------------------
# Runtime Postgres connection. It MUST use a dedicated non-admin LOGIN that
# inherits only `letletme_web_auth`. Startup performs static URL and pool
# validation only; CI and Database Migrate perform the full privilege audit.
# A pooler URL is supported.
DATABASE_URL=postgres://letletme_web_runtime:password@127.0.0.1:5432/letletme
# Per-Vercel-instance ceiling; values above 2 are rejected because instances
# share one bounded Supavisor runtime login.
DATABASE_POOL_MAX=2
# Direct administrator connection used only by db:migrate, db:migrate:status,
# db:verify-runtime-login, and new-environment bootstrap. It must never be
# supplied as runtime DATABASE_URL.
DIRECT_DATABASE_URL=postgres://migration_admin:password@127.0.0.1:5432/letletme

# New environments only. Run db:migrate first, then provide a complete URL and
# run db:bootstrap-runtime-login once. Existing roles are verified and their
# passwords are never replaced.
WEB_RUNTIME_DATABASE_URL=postgres://letletme_web_runtime:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@127.0.0.1:5432/letletme

# 32+ byte random string. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WeChat Mini Program login (wx.login -> code2Session).
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=

# 32+ byte random string shared with the GraphQL backend so it can verify
# the X-User-Context envelope. Generate with `openssl rand -base64 32`.
BACKEND_PROXY_SECRET=

# Authenticated Desk Agent Gateway. Keep disabled for additive deployment,
# then enable only after GraphQL and staging verification. When the optional
# comma-separated user-id allowlist is empty, every authenticated user is in
# scope. These values are server-only and must never use NEXT_PUBLIC_ prefixes.
AGENT_TOOLS_ENABLED=false
AGENT_BETA_USER_IDS=

# 32+ byte random server-only credential shared with GraphQL. Public RSC reads
# send it as X-GraphQL-Service-Token; it never represents a user identity.
GRAPHQL_SERVICE_TOKEN=

# Resend (verification, password reset, and Mini Program linking codes).
RESEND_API_KEY=
MAIL_FROM=no-reply@letletme.top
