# --- Existing -----------------------------------------------------------
GRAPHQL_ENDPOINT=http://127.0.0.1:4000/graphql
TOURNAMENT_API_BASE_URL=http://127.0.0.1:4001
# Server-only plaintext credential. Its SHA-256 digest belongs in Data's
# DATA_API_KEY_HASHES. Never prefix this variable with NEXT_PUBLIC_.
TOURNAMENT_API_KEY=

# Hard-cutover switch for Data Platform v3. With this exact value, all pages
# render the localized maintenance state and Data/GraphQL-dependent Web APIs
# return 503. Better Auth and Mini Program identity APIs remain available.
# Server-only: never prefix either variable with NEXT_PUBLIC_.
MAINTENANCE_MODE=false
# Integer seconds from 30 through 3600. Invalid values use 300 seconds.
MAINTENANCE_RETRY_AFTER_SECONDS=300

# letletme_data sync service (writer of entry_infos). Optional — the URL falls
# back to TOURNAMENT_API_BASE_URL, then http://127.0.0.1:4001; same deployment
# today. After a user binds an FPL entry, the web asks this service to sync it
# so the daily cron and GraphQL entry(id) pick it up.
LETLETME_DATA_URL=http://127.0.0.1:4001
# Plaintext key sent as x-api-key on the entry-sync call; its SHA-256 digest
# belongs in Data's DATA_API_KEY_HASHES. REQUIRED in production (Data enforces
# auth under NODE_ENV=production). Falls back to TOURNAMENT_API_KEY and may
# reuse the same value. Never prefix with NEXT_PUBLIC_.
LETLETME_DATA_API_KEY=

# Fraction of production page loads that report privacy-bounded Core Web
# Vitals to /api/vitals. Use a value from 0 to 1 (defaults to 0.25).
NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=0.25

# --- Better Auth + Drizzle (new) ---------------------------------------
# Runtime Postgres connection. It MUST use a dedicated non-admin LOGIN that
# inherits only `letletme_web_auth`; startup fails if the login can access Data
# Platform schemas or the Web migration ledger. A pooler URL is supported.
DATABASE_URL=postgres://letletme_web_runtime:password@127.0.0.1:5432/letletme
# Direct administrator connection used only by db:migrate, db:migrate:status,
# and role provisioning. It must never be supplied as runtime DATABASE_URL.
DIRECT_DATABASE_URL=postgres://migration_admin:password@127.0.0.1:5432/letletme

# 32+ byte random string. Generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WeChat Mini Program login (wx.login -> code2Session).
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=

# Set true only after migrating `drizzle/0001_miniprogram_account.sql` (live Supabase omits those tables today).
MINIPROGRAM_ACCOUNT_STORAGE=

# 32+ byte random string shared with the GraphQL backend so it can verify
# the X-User-Context envelope. Generate with `openssl rand -base64 32`.
BACKEND_PROXY_SECRET=

# 32+ byte random server-only credential shared with GraphQL. Public RSC reads
# send it as X-GraphQL-Service-Token; it never represents a user identity.
GRAPHQL_SERVICE_TOKEN=

# Resend (verification, password reset, and Mini Program linking codes).
RESEND_API_KEY=
MAIL_FROM=no-reply@letletme.top
