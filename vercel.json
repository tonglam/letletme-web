{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"git": {
		"deploymentEnabled": {
			"**": false,
			"main": false
		}
	},
	"functions": {
		"app/api/**/*.ts": {
			"maxDuration": 10
		}
	},
	"ignoreCommand": "node scripts/vercel-ignore-build.mjs",
	"regions": ["sin1"],
	"crons": [
		{
			"path": "/api/cron/auth-event-cleanup",
			"schedule": "17 2 * * *"
		}
	]
}
